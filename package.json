{
  "name": "extent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An evidence desk for inspectable answers across a Drive folder.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "pnpm --filter @extent/web build",
    "build:check": "EXTENT_NEXT_DIST_DIR=.next-check pnpm --filter @extent/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm migrate:check && pnpm openapi:check && pnpm build:check",
    "dev": "pnpm dev:web",
    "dev:api": ".venv/bin/python -m uvicorn extent_api.main:app --reload --reload-dir apps/api/src --app-dir apps/api/src",
    "dev:worker": ".venv/bin/python -m extent_api.worker",
    "dev:web": "pnpm --filter @extent/web dev",
    "format": "pnpm format:web && pnpm format:api",
    "format:api": ".venv/bin/ruff format apps/api",
    "format:check": "pnpm format:check:web && pnpm format:check:api",
    "format:check:api": ".venv/bin/ruff format --check apps/api",
    "format:check:web": "prettier --check package.json pnpm-workspace.yaml tsconfig.base.json vitest.config.mjs eslint.config.mjs .prettierrc.json render.yaml README.md PRODUCT.md DESIGN.md apps/web apps/api/README.md apps/api/src/extent_api/fixtures/alder_peak_workspace.json docs",
    "format:web": "prettier --write package.json pnpm-workspace.yaml tsconfig.base.json vitest.config.mjs eslint.config.mjs .prettierrc.json render.yaml README.md PRODUCT.md DESIGN.md apps/web apps/api/README.md apps/api/src/extent_api/fixtures/alder_peak_workspace.json docs",
    "lint": "pnpm lint:web && pnpm lint:api",
    "lint:api": ".venv/bin/ruff check apps/api",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis",
    "infra:reset": "docker compose down --volumes --remove-orphans",
    "infra:up": "docker compose up -d --wait postgres redis",
    "migrate": ".venv/bin/alembic -c apps/api/alembic.ini upgrade head",
    "migrate:check": ".venv/bin/python apps/api/scripts/check_migrations.py",
    "lint:web": "eslint apps/web eslint.config.mjs vitest.config.mjs --max-warnings 0",
    "openapi:check": ".venv/bin/python apps/api/scripts/export_openapi.py --check && pnpm openapi:client:check",
    "openapi:client:check": "openapi-typescript apps/api/openapi.json --output apps/web/src/generated/extent-api.ts --immutable --alphabetize --check && .venv/bin/python apps/api/scripts/export_openapi_schema_module.py --check",
    "openapi:client:generate": "openapi-typescript apps/api/openapi.json --output apps/web/src/generated/extent-api.ts --immutable --alphabetize && .venv/bin/python apps/api/scripts/export_openapi_schema_module.py",
    "openapi:generate": ".venv/bin/python apps/api/scripts/export_openapi.py && pnpm openapi:client:generate",
    "setup:api": "python3 -m venv .venv && .venv/bin/python -m pip install -r apps/api/requirements.lock && .venv/bin/python -m pip install --no-build-isolation --no-deps -e apps/api",
    "test": "pnpm test:web && pnpm test:api",
    "test:api": ".venv/bin/python -m pytest apps/api/tests",
    "test:web": "vitest run",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api",
    "typecheck:api": "MYPYPATH=apps/api/typings .venv/bin/mypy apps/api/src",
    "typecheck:web": "pnpm --filter @extent/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "openapi-typescript": "7.10.1",
    "prettier": "3.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "3.2.7"
  }
}
