# React application -> FastAPI (server-side only; never expose this as NEXT_PUBLIC_*).
EXTENT_API_INTERNAL_URL=http://127.0.0.1:8000
# Optional distinct target for Next.js's same-origin /api/backend/* rewrite.
EXTENT_API_PROXY_TARGET=http://127.0.0.1:8000

# FastAPI runtime. Local defaults are intentionally non-secret.
EXTENT_ENVIRONMENT=development
EXTENT_ALLOWED_ORIGINS=http://localhost:3000
EXTENT_DATABASE_URL=postgresql+psycopg://extent:extent@127.0.0.1:5432/extent
# Optional distinct release connection for Alembic when the runtime URL is pooled.
# EXTENT_DATABASE_MIGRATION_URL=postgresql+psycopg://user:password@render-postgres-host/database
EXTENT_REDIS_URL=redis://127.0.0.1:6379/0
EXTENT_QUEUE_NAME=extent
EXTENT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Google OAuth web client. The exact local authorized redirect URI is:
# http://localhost:3000/api/backend/v1/auth/google/callback
# Never add access tokens, refresh tokens, or ID tokens to this file.
# EXTENT_GOOGLE_CLIENT_ID=replace-with-google-web-client-id
# EXTENT_GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
# Generate a 32-byte versioned AEAD key, then keep the same value on the API and worker:
# python3 -c 'import base64,secrets; print("1:"+base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b"=").decode())'
# EXTENT_CREDENTIAL_ENCRYPTION_KEYS=1:replace-with-generated-base64url-key

# Server-only cited-answer model. Never expose this as NEXT_PUBLIC_* or log requests.
# EXTENT_MODEL_API_KEY=replace-with-provider-api-key
EXTENT_MODEL_BASE_URL=https://api.openai.com/v1
EXTENT_MODEL_NAME=gpt-5-mini

# Optional, independent embedding capability. Without this key Extent prepares sources and
# uses explicit lexical retrieval; do not assume the answer-model provider supports embeddings.
# EXTENT_EMBEDDING_API_KEY=replace-with-embedding-provider-api-key
EXTENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
EXTENT_EMBEDDING_MODEL=text-embedding-3-large
EXTENT_MODEL_TIMEOUT_SECONDS=120

# Docker Compose host ports. Change these together with the URLs above for isolated projects.
EXTENT_POSTGRES_PORT=5432
EXTENT_REDIS_PORT=6379
